+//! bulla verify, compiled to WebAssembly.
+//!
+//! The verification path in `bulla-core` is pure (no filesystem, no network, no
+//! clock): it re-checks the Ed25519 signature, the body digest, the event
+//! hash-chain, and recomputes the seal verdict from the attested policy. That
+//! makes it trivially portable to the browser — a judge can verify a receipt,
+//! or try to forge one and watch it fail, entirely client-side with no backend
+//! and no trust in any server.
+//!
+//! Exposes one function, `verify_receipt(json) -> json`, returning a small
+//! report object: { ok_json: bool, intact, sig_ok, digest_ok, chain_ok,
+//! seal_ok, command, exit, notes[], error }.
+
+use wasm_bindgen::prelude::*;
+
+/// Verify a bulla receipt supplied as a JSON string. Returns a JSON string with
+/// the verification report. Never panics: malformed input yields `error`.
+#[wasm_bindgen]
+pub fn verify_receipt(json: &str) -> String {
+    let report = match serde_json::from_str::<bulla_core::SignedReceipt>(json) {
+        Ok(sr) => {
+            let r = bulla_core::verify(&sr);
+            let exit = &sr.body.outcome;
+            serde_json::json!({
+                "ok_json": true,
+                "intact": r.intact(),
+                "sig_ok": r.sig_ok,
+                "digest_ok": r.digest_ok,
+                "chain_ok": r.chain_ok,
+                "seal_ok": r.seal_ok,
+                "command": sr.body.command.join(" "),
+                "exit_kind": exit.exit_kind,
+                "exit_code": exit.exit_code,
+                "pubkey": sr.pubkey,
+                "notes": r.notes,
+                "error": serde_json::Value::Null,
+            })
+        }
+        Err(e) => serde_json::json!({
+            "ok_json": false,
+            "intact": false,
+            "sig_ok": false,
+            "digest_ok": false,
+            "chain_ok": false,
+            "seal_ok": false,
+            "error": format!("not a valid bulla receipt JSON: {e}"),
+        }),
+    };
+    report.to_string()
+}
+
+/// Library version string, for the page footer.
+#[wasm_bindgen]
+pub fn version() -> String {
+    env!("CARGO_PKG_VERSION").to_string()
+}
