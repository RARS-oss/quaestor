+/// Append one hashed call record to the broker log (host-only, tamper-evident).
+fn log_call(logf: &mut fs::File, call: bc::LoggedCall) {
+    if let Ok(js) = serde_json::to_string(&call) {
+        let _ = writeln!(logf, "{js}");
+        let _ = logf.flush();
+    }
+}
+
+/// Bidirectional TLS-passthrough pump between the in-cell client (Unix socket) and
+/// the upstream TCP connection. The cell terminates TLS itself, so the broker only
+/// ever sees ciphertext — it records the byte-level transcript hashes per direction
+/// without being able to read (or forge) the plaintext. Returns
+/// (uplink_sha256, uplink_bytes, downlink_sha256, downlink_bytes). One HTTPS
+/// request per tunnel: the cell sends `Connection: close`, so the exchange closing
+/// the response ends the pump. Bounded to `cap` bytes per direction.
+fn tunnel(client: UnixStream, upstream: TcpStream, cap: usize) -> (String, u64, String, u64) {
+    let empty = bc::sha256_hex(b"");
+    let mut c_read = match client.try_clone() {
+        Ok(s) => s,
+        Err(_) => return (empty.clone(), 0, empty, 0),
+    };
+    let mut c_write = client;
+    let mut u_read = match upstream.try_clone() {
+        Ok(s) => s,
+        Err(_) => return (empty.clone(), 0, empty, 0),
+    };
+    let mut u_write = upstream;
+    // The uplink pump wakes each second to observe `done`; the downlink pump ends
+    // when the exchange closes (or 30s idle).
+    let _ = c_read.set_read_timeout(Some(Duration::from_secs(1)));
+    let _ = u_read.set_read_timeout(Some(Duration::from_secs(30)));
+    let done = Arc::new(AtomicBool::new(false));
+    let done_up = Arc::clone(&done);
+    std::thread::scope(|s| {
+        let up = s.spawn(move || pump_until(&mut c_read, &mut u_write, cap, &done_up));
+        let (down_sha, down_bytes) = pump_once(&mut u_read, &mut c_write, cap);
+        done.store(true, Ordering::SeqCst);
+        let (up_sha, up_bytes) = up.join().unwrap_or((bc::sha256_hex(b""), 0));
+        (up_sha, up_bytes, down_sha, down_bytes)
+    })
+}
+
+/// Copy src->dst until EOF/error/cap, hashing the bytes copied.
+fn pump_once<R: Read, W: Write>(src: &mut R, dst: &mut W, cap: usize) -> (String, u64) {
+    let mut acc: Vec<u8> = Vec::new();
+    let mut buf = [0u8; 16384];
+    loop {
+        match src.read(&mut buf) {
+            Ok(0) => break,
+            Ok(n) => {
+                if dst.write_all(&buf[..n]).is_err() {
+                    break;
+                }
+                let _ = dst.flush();
+                acc.extend_from_slice(&buf[..n]);
+                if acc.len() >= cap {
+                    break;
+                }
+            }
+            Err(_) => break,
+        }
+    }
+    (bc::sha256_hex(&acc), acc.len() as u64)
+}
+
+/// Like `pump_once`, but a read timeout is treated as "idle": break only once
+/// `done` is set (the other direction finished). Keeps the uplink half from
+/// blocking forever after the response has been fully relayed.
+fn pump_until<R: Read, W: Write>(
+    src: &mut R,
+    dst: &mut W,
+    cap: usize,
+    done: &AtomicBool,
+) -> (String, u64) {
+    let mut acc: Vec<u8> = Vec::new();
+    let mut buf = [0u8; 16384];
+    loop {
+        match src.read(&mut buf) {
+            Ok(0) => break,
+            Ok(n) => {
+                if dst.write_all(&buf[..n]).is_err() {
+                    break;
+                }
+                let _ = dst.flush();
+                acc.extend_from_slice(&buf[..n]);
+                if acc.len() >= cap {
+                    break;
+                }
+            }
+            Err(ref e)
+                if e.kind() == std::io::ErrorKind::WouldBlock
+                    || e.kind() == std::io::ErrorKind::TimedOut =>
+            {
+                if done.load(Ordering::SeqCst) {
+                    break;
+                }
+            }
+            Err(_) => break,
+        }
+    }
+    (bc::sha256_hex(&acc), acc.len() as u64)
+}
