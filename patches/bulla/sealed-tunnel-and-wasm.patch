+//! zkrisk — tiny JSON CLI over bulla-zk for quaestor (Alpaca hackathon agent).
+//!
+//!   zkrisk prove <value_u64> <cap_bits>   -> RiskProof JSON on stdout
+//!   zkrisk verify [file.json]             -> {"ok":bool} on stdout (stdin if no file), exit 0/1
+//!
+//! quaestor proves per order: "worst-case loss (whole dollars) < 2^16" — a
+//! zero-knowledge catastrophic-order guard. The Pedersen commitment prefix is
+//! embedded in the Alpaca client_order_id; the proof JSON is sealed into the
+//! bulla receipt for the cycle.
+
+use bulla_zk::{prove_within_cap, verify_within_cap, RiskProof};
+use std::io::Read;
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    match args.get(1).map(|s| s.as_str()) {
+        Some("prove") => {
+            let value: u64 = args
+                .get(2)
+                .and_then(|s| s.parse().ok())
+                .expect("usage: zkrisk prove <value_u64> <cap_bits>");
+            let cap_bits: usize = args
+                .get(3)
+                .and_then(|s| s.parse().ok())
+                .expect("usage: zkrisk prove <value_u64> <cap_bits>");
+            let proof = prove_within_cap(value, cap_bits);
+            // prove_within_cap happily "proves" an over-cap value; the proof just
+            // fails verification. Self-check so callers can trust exit code 0.
+            if !verify_within_cap(&proof) {
+                eprintln!("{{\"error\":\"proof does not verify (value >= 2^cap_bits?)\"}}");
+                std::process::exit(1);
+            }
+            println!("{}", serde_json::to_string(&proof).expect("serialize RiskProof"));
+        }
+        Some("verify") => {
+            let mut buf = String::new();
+            match args.get(2) {
+                Some(path) => buf = std::fs::read_to_string(path).expect("read proof file"),
+                None => {
+                    std::io::stdin().read_to_string(&mut buf).expect("read stdin");
+                }
+            }
+            let proof: RiskProof = serde_json::from_str(&buf).expect("RiskProof JSON");
+            let ok = verify_within_cap(&proof);
+            println!("{}", serde_json::json!({ "ok": ok }));
+            std::process::exit(if ok { 0 } else { 1 });
+        }
+        _ => {
+            eprintln!("usage: zkrisk prove <value_u64> <cap_bits> | zkrisk verify [file.json]");
+            std::process::exit(2);
+        }
+    }
+}
