# quaestor environment — copy to .env and fill in. NEVER commit .env (gitignored).
#
# Credentials come from your Alpaca PAPER account dashboard
# (https://app.alpaca.markets -> Paper Trading -> API Keys).
# Env var names follow the Alpaca CLI/MCP convention.

# Alpaca paper-trading API key pair (required)
ALPACA_API_KEY=your-paper-api-key-here
ALPACA_SECRET_KEY=your-paper-secret-key-here

# Featherless AI key for the optional sentiment path (openai/gpt-oss-20b).
# Leave empty to disable sentiment — trading never blocks on it.
FEATHERLESS_API_KEY=

# ============================================================================
# WARNING — DO NOT ADD ALPACA_LIVE_TRADE TO THIS FILE OR YOUR ENVIRONMENT.
# quaestor is PAPER-ONLY. If ALPACA_LIVE_TRADE is set to any truthy value,
# load_settings() refuses to start (fail-closed paper gate). There is no
# supported way to point this agent at a live account.
# ============================================================================
